POSTGRES_DB=hotel_review_db
POSTGRES_USER=hotel_admin
POSTGRES_PASSWORD=hotel_admin_123
POSTGRES_PORT=15432
APP_PORT=13000
DATABASE_URL=postgresql+psycopg://hotel_admin:hotel_admin_123@localhost:15432/hotel_review_db
DEFAULT_TIMEZONE=Asia/Bangkok
BAD_REVIEW_RATING_THRESHOLD=9
TRANSLATION_PROVIDER=googletrans
GOOGLE_TRANSLATE_ENABLED=false
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TARGET_LANGUAGE=vi
GOOGLE_TRANSLATE_TIMEOUT_SECONDS=15
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
BACKUP_ENABLED=true
BACKUP_LOCAL_DIR=/app/backups
BACKUP_DRIVE_REMOTE=
BACKUP_DRIVE_ROOT_FOLDER=hotel-review-backup
BACKUP_DRIVE_DAILY_SUBFOLDERS=true
BACKUP_KEEP_LOCAL_DAYS=14
BACKUP_DB_HOST=postgres
BACKUP_DB_PORT=5432
BACKUP_DB_NAME=hotel_review_db
BACKUP_DB_USER=hotel_admin
BACKUP_DB_PASSWORD=hotel_admin_123
BACKUP_RCLONE_CONFIG_PATH=/root/.config/rclone/rclone.conf
PGADMIN_DEFAULT_EMAIL=admin@datac.click
